---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const ordre = { actif: 0, 'a-venir': 1, differe: 2 } as Record<string, number>;
const libelleStatut = { actif: 'disponible', 'a-venir': 'à venir', differe: 'différé' } as Record<string, string>;
const fonctions = (await getCollection('fonctions')).sort(
  (a, b) => (ordre[a.data.statut] ?? 9) - (ordre[b.data.statut] ?? 9)
);
---
<Base>
  <section class="bandeau">
    <div class="enveloppe">
      <h1 class="accroche-grande">Le droit contient déjà les outils pour <em>sortir un bien du marché</em>.</h1>
      <p class="chapo">
        Ce site vous apprend à les <strong>nommer</strong>, à les <strong>assembler</strong>,
        et à vous faire accompagner pour les mettre en place. Pas de modèle sans outil,
        pas d'outil sans précédent.
      </p>
    </div>
  </section>
  <main class="contenu">
    <div class="enveloppe">
      <p class="sur-titre">Qu'est-ce qui vous amène ?</p>
      <div class="fonctions-grille">
        {fonctions.map((f) => {
          const actif = f.data.statut === 'actif';
          const cls = `fonction-carte${actif ? '' : ' inactive'}${f.data.brouillon ? ' brouillon' : ''}`;
          const Tag = actif ? 'a' : 'div';
          return (
            <Tag class={cls} href={actif ? `/modeles/fonctions/${f.id}` : undefined}>
              <span class="module">{f.data.module}</span>
              <span class="titre-fonction">{f.data.nom}</span>
              <span class="sous">{f.data.sous_titre}</span>
              <span class="etat">{f.data.brouillon ? 'brouillon' : libelleStatut[f.data.statut]}</span>
            </Tag>
          );
        })}
      </div>

      <hr />

      <div class="colonne-texte">
        <h2>Ce que ce site fait que les autres ne font pas</h2>
        <p>
          Il ne porte pas de terre et n'opère pas de commun — pour cela, voir les
          acteurs qui le font, qu'il documente comme précédents. Il ne donne pas la
          loi en catalogue : il <strong>nomme ce que vous faites déjà</strong> pour le
          rendre opposable. Et il <strong>trie</strong> — tous les dispositifs ne
          libèrent pas également : il dit lesquels <em>retirent</em> le bien du marché
          et lesquels se contentent de <em>plafonner</em> le gain.
        </p>
      </div>
    </div>
  </main>
</Base>
