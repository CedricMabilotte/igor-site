---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
const {
  titre = 'Projet Plan B — Refaire culture en Communs',
  description = "Le droit contient déjà les outils pour sortir un bien du marché. Projet Plan B cartographie les montages juridiques de décommodification, les dispositifs et les précédents — et oriente vers l'accompagnement pour les mettre en place.",
} = Astro.props;
const menu = [
  { href: '/agir', texte: 'Agir' },
  { href: '/modeles', texte: 'Modèles' },
  { href: '/ils-l-ont-fait', texte: "Ils l'ont fait" },
  { href: '/comprendre', texte: 'Comprendre' },
];
// Emblème provisoire — rameau d'if (longévif, sempervirent, arbre des seuils).
// Charte définitive et emblème à arbitrer avec @graphiste.
const mark = `<svg viewBox="0 0 100 100" aria-hidden="true"><path d="M50,92 L50,30" fill="none" stroke="#1C4A32" stroke-width="3.2" stroke-linecap="round"/><g stroke="#2E7D4E" stroke-width="2.4" stroke-linecap="round" fill="none"><path d="M50,40 C42,36 36,31 33,24"/><path d="M50,40 C58,36 64,31 67,24"/><path d="M50,52 C41,49 34,44 30,36"/><path d="M50,52 C59,49 66,44 70,36"/><path d="M50,64 C42,62 36,58 32,51"/><path d="M50,64 C58,62 64,58 68,51"/></g><circle cx="50" cy="26" r="3.2" fill="#E2622E"/></svg>`;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{titre}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="site-tete">
      <div class="enveloppe">
        <a class="marque" href="/">
          <Fragment set:html={mark} />
          <span>
            <span class="nom">Projet Plan B</span><br />
            <span class="accroche">Refaire culture en Communs</span>
          </span>
        </a>
        <nav class="menu">
          {menu.map((m) => <a href={m.href}>{m.texte}</a>)}
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site-pied">
      <div class="enveloppe">
        <a class="marque" href="/">
          <Fragment set:html={mark} />
          <span>
            <span class="nom">Projet Plan B</span><br />
            <span class="accroche">Refaire culture en Communs</span>
          </span>
        </a>
        <p style="margin-top:1.25rem;max-width:42rem;">
          Le droit contient déjà les outils pour sortir un bien du marché. Ce site
          apprend à les nommer, à les assembler, et oriente vers l'accompagnement
          pour les mettre en place. Information juridique générale, jamais conseil
          personnalisé.
        </p>
        <p class="mono" style="font-size:0.78rem;opacity:0.65;">
          projetplanb.org — site en construction
        </p>
      </div>
    </footer>
  </body>
</html>
