---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';

const { titre = 'Igor, le cosaque du kolkhoze — Refaire culture en Communs', description = "Igor cartographie le droit civil des Communs : dispositifs juridiques reproductibles, précédents documentés, mémoire des luttes. Il anime le Projet Plan B et d'autres modèles de Communs." } = Astro.props;

// Menu sur les pages existantes. L'arborescence cible (Problèmes / Dispositifs /
// Précédents / Carte) est proposée dans la bulle « structure-site-projetplanb »
// — à implémenter par @neo dans une phase ultérieure.
const menu = [
  { href: '/corpus', texte: 'Corpus' },
  { href: '/methode', texte: 'Méthode' },
  { href: '/a-propos', texte: 'À propos' },
];

// « La pousse tressée » — deux feuilles s'ouvrent d'une tige tressée, racinée.
const mark = `<svg viewBox="0 0 100 100" aria-hidden="true"><path d="M50,47 C45,46 33,45 24,16 C30,28 41,39 51,46 Z" fill="#2E7D4E"/><path d="M48,45 C40,38 32,30 27,20" fill="none" stroke="#F5F7F2" stroke-width="2.4" stroke-linecap="round" opacity="0.6"/><path d="M50,47 C55,46 67,45 76,16 C70,28 59,39 49,46 Z" fill="#E2622E"/><path d="M52,45 C60,38 68,30 73,20" fill="none" stroke="#F5F7F2" stroke-width="2.4" stroke-linecap="round" opacity="0.6"/><g fill="none" stroke-width="7" stroke-linecap="round"><path d="M50,47 C44,51 44,55 50,58 C56,61 56,68 50,73 C45,76 46,80 50,84" stroke="#2E7D4E"/><path d="M50,47 C56,51 56,55 50,58 C44,61 44,68 50,73 C55,76 54,80 50,84" stroke="#E2622E"/><path d="M45.5,55.5 C47,56.6 48.5,57.4 50,58 C52,59 54,60 55.6,61.4" stroke="#2E7D4E"/></g><g fill="none" stroke="#2E7D4E" stroke-width="3.4" stroke-linecap="round"><path d="M50,84 C46,87 43,89 39,93"/><path d="M50,84 C50,88 50,90 50,95"/><path d="M50,84 C54,87 57,89 61,93"/></g></svg>`;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{titre}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="site-tete">
      <div class="enveloppe">
        <a class="marque" href="/">
          <Fragment set:html={mark} />
          <span>
            <span class="nom">Igor, le cosaque du kolkhoze</span><br />
            <span class="accroche">Refaire culture en Communs</span>
          </span>
        </a>
        <nav class="menu">
          {menu.map((m) => <a href={m.href}>{m.texte}</a>)}
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-pied">
      <div class="enveloppe">
        <a class="marque" href="/">
          <Fragment set:html={mark} />
          <span>
            <span class="nom">Igor, le cosaque du kolkhoze</span><br />
            <span class="accroche">Refaire culture en Communs</span>
          </span>
        </a>
        <p style="margin-top:1.25rem;max-width:42rem;">
          Igor cartographie le droit civil des Communs — dispositifs reproductibles,
          précédents documentés, mémoire des luttes. Il anime le Projet Plan B et
          d'autres modèles de Communs. Fait avant principe, outil avant modèle.
        </p>
        <p class="mono" style="font-size:0.78rem;opacity:0.65;">
          projetplanb.org — corpus en construction — contenu d'illustration
        </p>
      </div>
    </footer>
  </body>
</html>
